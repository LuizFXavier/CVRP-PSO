{
  "version": 2,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "profiling",
      "displayName": "Build para Profiling (perf)",
      "description": "Ativa otimizações, símbolos de debug e preserva o frame pointer.",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -fno-omit-frame-pointer",
        "USE_OPENMP": "OFF"
      },
      "environment": {
        "CXXFLAGS": "-fno-omit-frame-pointer"
      }
    },
    {
      "name": "omp-profiling",
      "displayName": "Profiling paralelo (com OpenMP)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -fno-omit-frame-pointer"
      },
      "environment": {
        "CXXFLAGS": "-fno-omit-frame-pointer"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "sycl-dev",
      "inherits": "default",
      "cacheVariables": {

        "CMAKE_BUILD_TYPE": "Debug",
        
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AdaptiveCpp_DIR": "/opt/acpp/lib/cmake/AdaptiveCpp",
        "AdaptiveCpp_ROOT": "/opt/acpp",
        "CMAKE_CXX_COMPILER": "/opt/acpp/bin/acpp",
        "CMAKE_PREFIX_PATH": "/opt/acpp",

        "ACPP_TARGETS":"generic",

        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "sycl-release",
      "displayName": "SYCL com AdaptiveCpp (Otimizado/Release)",
      "description": "Build otimizada para máximo desempenho em GPU",
      "inherits": "sycl-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -ffast-math",
        "ACPP_TARGETS": "generic" 
      }
}
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "profiling",
      "configurePreset": "profiling",
      "displayName": "Build Profiling",
      "description": "Compila o projeto com as configurações de profiling"
    },
    {
      "name": "omp-profiling",
      "configurePreset": "omp-profiling",
      "displayName": "Profiling com OpenMP ativo",
      "description": "Compila o projeto com as configurações de profiling com OpenMP ativo"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "sycl-dev",
      "configurePreset": "sycl-dev",
      "displayName": "SYCL com AdaptiveCpp",
      "description": "Build para desenvolvimento com o SYCL dentro de um ambiente configurado"
    },
    {
      "name": "sycl-release",
      "configurePreset": "sycl-release",
      "displayName": "Build SYCL Release",
      "description": "Compila o projeto com otimizações do AdaptiveCpp"
    }
  ]
}
